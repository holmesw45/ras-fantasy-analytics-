SELECT player, "40 Yard", forty_pct
FROM RAS_PROJECT.PUBLIC.stg_combine_percentiles p
JOIN RAS_PROJECT.PUBLIC.combine_results c USING (player, POS, year)
WHERE p.POS = 'WR'
ORDER BY "40 Yard" ASC NULLS LAST
LIMIT 5;

SELECT
  COUNT(*) AS total,
  COUNT_IF("Height (in)" IS NOT NULL
       AND "Weight (lbs)" IS NOT NULL
       AND "40 Yard" IS NOT NULL
       AND shuttle IS NOT NULL) AS meets_required
FROM RAS_PROJECT.PUBLIC.combine_results;

