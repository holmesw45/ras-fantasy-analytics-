SELECT COUNT(*) FROM RAS_PROJECT.PUBLIC.ras_ppg_2024;

SELECT
    POS,
    CASE WHEN ras_score >= 8 THEN 'elite'
         WHEN ras_score >= 6 THEN 'good'
         WHEN ras_score >= 4 THEN 'average'
         ELSE 'poor' END AS ras_tier,
    COUNT(*) AS players,
    ROUND(AVG(ppg), 2) AS avg_ppg
FROM RAS_PROJECT.PUBLIC.ras_ppg_2024
WHERE ras_score IS NOT NULL AND G >= 4
GROUP BY 1, 2
ORDER BY POS, ras_tier;
