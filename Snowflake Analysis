CREATE TABLE combine_results(
    year INT,
    player VARCHAR,
    college VARCHAR,
    POS VARCHAR,
    height DECIMAL(4,2),
    weight INT,
    arm_length DECIMAL(4,2),
    hand_size DECIMAL(4,2),
    forty_yard DECIMAL(4,2),
    vert_leap DECIMAL(4,2),
    broad_jump INT,
    three_cone DECIMAL(4,2),
    shuttle DECIMAL(4,2),
    bench_press INT
);


SELECT COUNT(*) FROM RAS_PROJECT.PUBLIC.combine_results;
