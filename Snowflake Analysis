SELECT player, "Vert Leap (in)", vert_leap_pct
FROM RAS_PROJECT.PUBLIC.stg_combine_percentiles p
JOIN RAS_PROJECT.PUBLIC.combine_results c USING (player)
WHERE p.POS = 'WR'
ORDER BY vert_leap_pct DESC NULLS LAST
LIMIT 10;

SELECT player, "Vert Leap (in)"
FROM RAS_PROJECT.PUBLIC.combine_results
WHERE POS = 'WR'
ORDER BY "Vert Leap (in)" DESC NULLS LAST
LIMIT 5;

SELECT player, POS, vert_leap_pct
FROM RAS_PROJECT.PUBLIC.stg_combine_percentiles
WHERE player = 'Josh Imatorbhebhe';

SELECT
  COUNT(*) AS all_wr,
  COUNT("Vert Leap (in)") AS has_vert
FROM RAS_PROJECT.PUBLIC.combine_results
WHERE POS = 'WR';

SELECT player, vert_leap_pct
FROM RAS_PROJECT.PUBLIC.stg_combine_percentiles
